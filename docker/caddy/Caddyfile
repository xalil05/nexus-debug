# =============================================================================
# Nexus-Debug — Caddy reverse proxy (HTTP via Tailscale)
# =============================================================================
# La connexion Tailscale est déjà chiffrée par WireGuard,
# pas besoin de HTTPS supplémentaire.
:9000 {
    reverse_proxy nexus:9001
    encode gzip
    header Access-Control-Allow-Origin "*"
    header Access-Control-Allow-Methods "GET, POST, OPTIONS"
    header Access-Control-Allow-Headers "Authorization, Content-Type"
}
