# =============================================================================
# Nexus-Debug — Configuration
# Copier vers .env et remplir (NE PAS committer .env)
# =============================================================================

# ⚠️ SÉCURITÉ : Copier ce fichier en .env et remplir TOUS les secrets.
# Ne jamais commit .env dans Git.

# ── Obligatoire ───────────────────────────────────────────────────────────────
# Obtenir une clé sur https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=""

# ── Optionnel : Providers Multi-LLM ──────────────────────────────────────────
# DeepSeek est le provider par défaut. Définir les clés supplémentaires
# pour utiliser OpenAI, OpenRouter ou Anthropic en fallback.
# OPENAI_API_KEY=""
# OPENROUTER_API_KEY=""
# ANTHROPIC_API_KEY=""
# NEXUS_LLM_PROVIDER="deepseek"  # deepseek|openai|openrouter|anthropic

# ── Obligatoire : Sécurité API ────────────────────────────────────────────────
# Clé privée pour sécuriser l'API — obligatoire (l'API refuse de démarrer sans)
NEXUS_API_KEY="CHANGE_ME"

# ── Obligatoire si déploiement Docker ─────────────────────────────────────────
# Mot de passe admin Grafana (changer impérativement)
GF_SECURITY_ADMIN_PASSWORD="CHANGE_ME"

# ── Optionnel : Modèle ────────────────────────────────────────────────────────
NEXUS_MODEL="deepseek-chat"

# ── Optionnel : API ───────────────────────────────────────────────────────────
NEXUS_API_HOST="0.0.0.0"
NEXUS_API_PORT="9001"
NEXUS_CORS_ORIGIN="http://localhost:9001"

# ── Optionnel : Limites ───────────────────────────────────────────────────────
NEXUS_RATE_LIMIT="10/minute"
NEXUS_MAX_BRIEF_LENGTH="5000"

# ── Optionnel : Persistence (chemins par défaut /data/nexus/) ─────────────────
NEXUS_DB_PATH="/data/nexus/nexus.db"
NEXUS_KB_PATH="/data/nexus/kb/nexus_kb.yaml"
NEXUS_REPORTS_DIR="/data/nexus/reports"
NEXUS_FEEDBACK_PATH="/data/nexus/feedback/nexus_feedback.yaml"

# ── Optionnel : Codebase (chemin du code à analyser) ──────────────────────────
NEXUS_CODEBASE_PATH="/app/workspace"

# ── Optionnel : Webhooks / Notifications ─────────────────────────────────────
GITHUB_WEBHOOK_SECRET=""
GITHUB_TOKEN=""
SLACK_WEBHOOK_URL=""
